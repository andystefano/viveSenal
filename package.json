{
  "name": "vivesenal",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@heroicons/react": "^1.0.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.0.1",
    "react-router-dom": "^6.22.3",
    "sortablejs": "^1.15.7",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint resources/js --ext .js,.jsx",
    "lint:fix": "eslint resources/js --ext .js,.jsx --fix"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ],
    "rules": {
      "no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_",
          "varsIgnorePattern": "^_"
        }
      ],
      "react/no-unknown-property": "error"
    },
    "ignorePatterns": [
      "resources/js/componentes/Section1 - copia.js"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-react-app": "^7.0.1",
    "laravel-vite-plugin": "^1.2.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.1",
    "vite": "^6.0.11"
  }
}
